# Dependencies (this is a dsh plugin, not an npm app)
node_modules/
pnpm-debug.log*
.pnpm-debug.log*

# Local scratch: one-off patch scripts, screenshots, screenshots of the GUI
tmp/

# ---------------------------------------------------------------------------
# Copyrighted material: keep these out of the repo.
# The Minecraft soundtrack (C418) and the extra wallpapers are third-party
# assets that we have no permission to redistribute.
#
# NOTE: the 5 UI sound samples in assets/sfx/ ARE bundled with this plugin by
# the author's decision (they make the click/chest sounds convincing). They are
# Mojang assets, NOT covered by the MIT license, and remain the property of
# their rights holders — see LICENSE + assets/sfx/README.md. To go back to the
# conservative stance, re-add:
#   assets/sfx/*
#   !assets/sfx/README.md
# ---------------------------------------------------------------------------
assets/music/*
!assets/music/README.md

# Wallpapers other than the single bundled base wallpaper (same reason).
assets/wallpapers/*.webp
!assets/wallpapers/cozy-cabin.webp
!assets/wallpapers/cozy-cabin.thumb.webp
assets/wallpapers/_src/
assets/wallpapers/manifest.local.json
